{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "backfill:embeddings": "tsx src/scripts/backfill-embeddings.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@huggingface/transformers": "^4.2.0",
    "@rss-agg/contract": "workspace:*",
    "@rss-agg/db": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/fastify": "3.52.1",
    "dotenv": "^16.4.7",
    "effect": "^3.11.7",
    "fastify": "^4.29.1",
    "node-schedule": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "tsyringe": "^4.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@rss-agg/eslint-config": "workspace:*",
    "@rss-agg/typescript-config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/node-schedule": "^2.1.7",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
