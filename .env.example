# Copy to .env.local in apps/api and apps/web (see each app's own .env.example).
# Create a Supabase project at https://supabase.com, then run
# packages/db/migrations/0001_init.sql in its SQL editor.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- API (apps/api) ---
PORT=3000
NODE_ENV=development
RSS_FETCH_TIMEOUT_MS=10000
RSS_FETCH_CONCURRENCY=3
REFRESH_INTERVAL_MS=3600000
CORS_ORIGIN=http://localhost:5173

# --- Web (apps/web), must be prefixed VITE_ to reach the browser ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000
